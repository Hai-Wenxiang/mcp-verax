# ---- 密钥与环境（永不入库）----
.env
.env.*
*.pem
*.key
secrets/

# ---- Node / TypeScript ----
node_modules/
dist/
build/
out/
*.tsbuildinfo
.eslintcache
.turbo/
.coverage
coverage/
*.log
npm-debug.log*
pnpm-debug.log*

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist-packages/

# ---- IDE / 编辑器 ----
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- 系统杂项 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 本项目特有 ----
corpus-untrusted/          # 不可信样本隔离目录（独立子仓管理）
fixtures/**/*.real.json    # 录制的真实响应默认不入库（含敏感字段）
