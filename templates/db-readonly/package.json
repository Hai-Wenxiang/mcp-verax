{
  "name": "db-readonly-template",
  "version": "0.1.0",
  "description": "Verax template: read-only queries on JSONL tables, zero dependencies.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hai-Wenxiang/mcp-verax"
  },
  "type": "module",
  "bin": { "db-readonly": "./index.js" },
  "verax-template": {
    "id": "db-readonly",
    "variables": [
      { "name": "VERAX_ROOT", "desc": "allowed root directory", "default": "./data" },
      { "name": "VERAX_MAX_ROWS", "desc": "row cap", "default": "20000" }
    ]
  }
}
