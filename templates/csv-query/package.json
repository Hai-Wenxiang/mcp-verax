{
  "name": "csv-query-template",
  "version": "0.1.0",
  "description": "Verax template: query CSV files with containment and size caps, zero dependencies.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hai-Wenxiang/mcp-verax"
  },
  "type": "module",
  "bin": { "csv-query": "./index.js" },
  "verax-template": {
    "id": "csv-query",
    "variables": [
      { "name": "VERAX_ROOT", "desc": "allowed root directory", "default": "./data" },
      { "name": "VERAX_MAX_ROWS", "desc": "row cap", "default": "5000" },
      { "name": "VERAX_MAX_FILE_BYTES", "desc": "file size cap", "default": "5242880" }
    ]
  }
}
