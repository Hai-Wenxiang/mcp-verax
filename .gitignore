node_modules/
dist/
build/
out/
*.tsbuildinfo
.eslintcache
.turbo/
.coverage
coverage/
*.log
npm-debug.log*
pnpm-debug.log*

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
