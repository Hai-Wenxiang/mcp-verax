*.swp

# ===== 系统杂项 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 本项目特有 =====
# 不可信样本隔离目录（独立子仓管理）
corpus-untrusted/
# 录制的真实响应默认不入库（含敏感字段）
fixtures/**/*.real.json
# 实时进展日志：仅本地记录，不入库（见 AGENTS.md）
WORKLOG.md
# 构建产物
bin/
dist-out/
__snapshots__/tmp/
